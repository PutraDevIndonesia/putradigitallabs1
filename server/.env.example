# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# Port server API
PORT=4000

# Origin frontend yang diizinkan (pisahkan dengan koma bila lebih dari satu)
CLIENT_ORIGIN=http://localhost:5173

# Firebase Realtime Database
# Ambil dari Firebase Console > Realtime Database (bentuk: https://<project>-default-rtdb.<region>.firebasedatabase.app)
FIREBASE_DATABASE_URL=

# Kredensial service account. Pilih salah satu cara:
# 1. Tempel isi serviceAccountKey.json sebagai satu baris JSON
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2. Atau simpan file JSON-nya, lalu isi path absolut di bawah ini
GOOGLE_APPLICATION_CREDENTIALS=

# Login dashboard admin
ADMIN_EMAIL=
# Gunakan salah satu: ADMIN_PASSWORD (teks biasa) atau ADMIN_PASSWORD_HASH (bcrypt, lebih aman)
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Bahasa utama penulisan konten di dashboard. Versi pasangannya diisi otomatis.
PRIMARY_LOCALE=id

# Terjemahan otomatis isi konten. Kosongkan provider bila belum ingin dipakai,
# maka admin hanya menulis satu bahasa dan pengunjung bahasa lain melihat teks aslinya.
# Pilihan provider: none | deepl | google
TRANSLATE_PROVIDER=none
TRANSLATE_API_KEY=
# Opsional: timpa alamat layanan, misalnya https://api.deepl.com/v2/translate untuk kunci DeepL Pro
TRANSLATE_ENDPOINT=

# Wajib diisi dengan string acak panjang. Contoh membuat:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opsional: folder hasil build frontend agar dilayani server ini di produksi
# CLIENT_DIST=../client/dist

# Unggahan berkas hasil proyek dan invoice dikirim lewat server ini, sehingga kunci
# penyimpanan tetap di sisi server dan tidak ikut ke peramban pengunjung.
STORAGE_API_KEY=
# Opsional: timpa alamat layanan penyimpanan.
STORAGE_BASE_URL=https://dashboard.mputraramadhani.id
