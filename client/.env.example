# Salin menjadi .env.local saat development.

# Kosongkan untuk memakai proxy Vite ke server Express di localhost:4000.
# Isi dengan URL penuh, misalnya https://api.domainanda.com/api, saat produksi.
VITE_API_BASE=

# Identitas kontak yang dipakai di footer dan halaman lacak status.
# Bagian yang kosong otomatis disembunyikan, jadi tidak ada data palsu yang tampil.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_WHATSAPP=
VITE_ADDRESS=
